<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://jurgenei.name/canonical"
           xmlns:c="http://jurgenei.name/canonical"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <xs:element name="Document" type="c:DocumentType"/>

    <xs:complexType name="DocumentType">
        <xs:sequence>
            <xs:element name="Metadata" type="c:MetadataType"/>
            <xs:element name="Body" type="c:BodyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MetadataType">
        <xs:sequence>
            <xs:element name="DocumentId" type="xs:string"/>
            <xs:element name="Version" type="xs:string" minOccurs="0"/>
            <xs:element name="SourceFile" type="xs:string"/>
            <xs:element name="DocumentType" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BodyType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Paragraph" type="c:ParagraphType"/>
            <xs:element name="List" type="c:ListType"/>
            <xs:element name="Table" type="c:TableType"/>
            <xs:element name="Link" type="c:LinkType"/>
            <xs:element name="Reference" type="c:ReferenceType"/>
            <xs:element name="Diagram" type="c:DiagramType"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="ParagraphType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Text" type="xs:string"/>
            <xs:any namespace="http://www.w3.org/1998/Math/MathML" processContents="lax"/>
        </xs:choice>
        <xs:attribute name="source-path" type="xs:string" use="optional"/>
        <xs:attribute name="label" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="ListType">
        <xs:sequence>
            <xs:element name="Item" type="c:ItemType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="ordered" type="xs:boolean" use="optional"/>
    </xs:complexType>

    <xs:complexType name="ItemType">
        <xs:sequence>
            <xs:element name="Text" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TableType">
        <xs:sequence>
            <xs:element name="Row" type="c:RowType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional"/>
        <xs:attribute name="source-path" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="RowType">
        <xs:sequence>
            <xs:element name="Cell" type="c:CellType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CellType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Text" type="xs:string"/>
            <xs:any namespace="http://www.w3.org/1998/Math/MathML" processContents="lax"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="LinkType">
        <xs:sequence>
            <xs:element name="Text" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="target" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="ReferenceType">
        <xs:sequence>
            <xs:element name="Text" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="target" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="DiagramType">
        <xs:sequence>
            <xs:element name="Shape" type="c:ShapeType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Connector" type="c:ConnectorType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Node" type="c:NodeType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Edge" type="c:EdgeType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Group" type="c:GroupType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Annotation" type="c:AnnotationType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="source-path" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="GroupType">
        <xs:sequence>
            <xs:element name="Label" type="xs:string" minOccurs="0"/>
            <xs:element name="Member" type="c:GroupMemberType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional"/>
        <xs:attribute name="semantic" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="GroupMemberType">
        <xs:attribute name="node" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="ShapeType">
        <xs:sequence>
            <xs:element name="Label" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="ConnectorType">
        <xs:attribute name="source" type="xs:string" use="optional"/>
        <xs:attribute name="target" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="NodeType">
        <xs:sequence>
            <xs:element name="Label" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional"/>
        <xs:attribute name="geometry" type="xs:string" use="optional"/>
        <xs:attribute name="semantic" type="xs:string" use="optional"/>
        <xs:attribute name="confidence" type="xs:decimal" use="optional"/>
    </xs:complexType>

    <xs:complexType name="EdgeType">
        <xs:sequence>
            <xs:element name="Label" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="source" type="xs:string" use="optional"/>
        <xs:attribute name="target" type="xs:string" use="optional"/>
        <xs:attribute name="directed" type="xs:boolean" use="optional"/>
        <xs:attribute name="semantic" type="xs:string" use="optional"/>
        <xs:attribute name="confidence" type="xs:decimal" use="optional"/>
    </xs:complexType>

    <xs:complexType name="AnnotationType">
        <xs:sequence>
            <xs:element name="Text" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="kind" type="xs:string" use="optional"/>
        <xs:attribute name="target" type="xs:string" use="optional"/>
        <xs:attribute name="confidence" type="xs:decimal" use="optional"/>
    </xs:complexType>
</xs:schema>

